# 必填：首次启动时创建 admin；管理员已存在时不会自动重置密码。
DSM_ADMIN_PASSWORD=replace-with-a-strong-password
# 是否开放注册页面和 API，只接受 true/false。
DSM_REGISTRATION_ENABLED=false
# HTTPS 部署时设为 true。
# DSM_COOKIE_SECURE=false
# 兼容作者旧服务的机器对机器 API；留空时对应接口关闭。
# DSH_REGISTER_API_KEY=replace-with-a-long-random-token
# DSH_LOGIN_API_KEY=replace-with-a-different-long-random-token
# LOGIN_TICKET_TTL=60
# 可选：私有 npm registry。留空时使用 pnpm/npm 默认 registry。
# DSM_PLUGIN_NPM_REGISTRY=https://registry.example.com/
# DSM_PLUGIN_NPM_TOKEN=replace-with-a-read-only-token
# DSM_LOG_LEVEL=INFO
